{
  "schema_version": 1,
  "id": "message_specificity",
  "title": "Message specificity",
  "lesson": "Change only level descriptions. Scores are expectations over indices 0 through 3, not integer labels.",
  "variants": {
    "baseline": {
      "preparation": "original",
      "questions": {
        "specificity": {
          "type": "score",
          "instructions": "Rate the specificity of the message. Choose the highest level whose description is satisfied.",
          "criteria": [
            "Generic",
            "Product named",
            "Concrete request",
            "Actionable detail"
          ]
        }
      }
    },
    "prepared": {
      "preparation": "original",
      "questions": {
        "specificity": {
          "type": "score",
          "instructions": "Rate the specificity of the message. Choose the highest level whose description is satisfied.",
          "criteria": [
            "Generic enquiry; no product is named and no concrete issue or request is stated.",
            "A product is named, but there is no concrete issue or requested action.",
            "A concrete issue or requested action is stated, but details needed to act are missing.",
            "A concrete issue or requested action includes useful details such as reproduction steps, an order identifier or an exact requested change."
          ]
        }
      }
    }
  },
  "comparisons": [
    [
      "baseline",
      "prepared"
    ]
  ],
  "cases": [
    {
      "id": "case-01",
      "state": "Hello, can you help me?",
      "language": "en",
      "split": "development",
      "expected": {
        "specificity": 0
      }
    },
    {
      "id": "case-02",
      "state": "I would like some information.",
      "language": "en",
      "split": "development",
      "expected": {
        "specificity": 0
      }
