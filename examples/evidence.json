{
  "schema_version": 1,
  "id": "evidence",
  "title": "Evidence and claims",
  "lesson": "Change only option descriptions. Missing evidence is an explicit category, not a false claim.",
  "variants": {
    "baseline": {
      "preparation": "original",
      "questions": {
        "relation": {
          "type": "choice",
          "instructions": "Using only the record, determine whether it supports the claim.",
          "criteria": {
            "supported": "supported",
            "contradicted": "contradicted",
            "insufficient_evidence": "insufficient evidence"
          }
        }
      }
    },
    "prepared": {
      "preparation": "original",
      "questions": {
        "relation": {
          "type": "choice",
          "instructions": "Using only the record, determine whether it supports the claim.",
          "criteria": {
            "supported": "The record provides evidence that the claim is true.",
            "contradicted": "The record provides evidence that conflicts with the claim.",
            "insufficient_evidence": "The record neither establishes the claim nor contradicts it; the needed fact is missing."
          }
        }
      }
    }
  },
  "comparisons": [
    [
      "baseline",
      "prepared"
    ]
  ],
  "cases": [
    {
      "id": "case-01",
      "state": {
        "record": "The parcel was delivered on Tuesday.",
        "claim": "The parcel arrived on Tuesday."
      },
      "language": "en",
      "split": "development",
      "expected": {
        "relation": "supported"
      }
    },
    {
      "id": "case-02",
      "state": {
        "record": "The parcel was delivered on Tuesday.",
        "claim": "The parcel arrived on Monday."
      },
      "language": "en",
