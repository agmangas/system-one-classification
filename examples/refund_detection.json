{
  "schema_version": 1,
  "id": "refund_detection",
  "title": "Explicit request detection",
  "lesson": "Change only the presence of explicit true/false criteria. The 0.5 cutoff is a demonstration convention.",
  "variants": {
    "baseline": {
      "preparation": "original",
      "questions": {
        "refund_requested": {
          "type": "noul",
          "instructions": "Does the author explicitly request a refund?"
        }
      }
    },
    "prepared": {
      "preparation": "original",
      "questions": {
        "refund_requested": {
          "type": "noul",
          "instructions": "Does the author explicitly request a refund?",
          "criteria": {
            "true": "The author asks to have a payment returned or a charge reversed.",
            "false": "The author does not ask for money back; they may discuss refunds, ask about policy, or explicitly decline a refund."
          }
        }
      }
    }
  },
  "comparisons": [
    [
      "baseline",
      "prepared"
    ]
  ],
  "cases": [
    {
